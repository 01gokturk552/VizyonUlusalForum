{
  "buildCommand": "echo 'Static site - no build needed'",
  "devCommand": "python -m http.server 3000",
  "outputDirectory": ".",
  "public": true,
  "github": {
    "enabled": true,
    "autoAlias": true
  },
  "env": {
    "EMAIL_USER": "@vizyon-email-user",
    "EMAIL_PASS": "@vizyon-email-pass",
    "PORT": "3000"
  },
  "redirects": [
    {
      "source": "/basvuru",
      "destination": "/basvuru.html"
    },
    {
      "source": "/ekibimiz",
      "destination": "/ekibimiz.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
