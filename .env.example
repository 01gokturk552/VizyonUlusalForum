# Backend E-posta Ayarları
# Google App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Sunucu Portı
PORT=3000

# Panel ve başvuru verilerinin kalıcı saklanacağı dosya
# Yerelde boş bırakılabilir. Render gibi ortamlarda kalıcı disk yolu kullanın.
DATA_FILE=

# CORS İzinli Originler (virgülle ayrılmış)
# Örnek: http://localhost:3000,https://example.com
ALLOWED_ORIGINS=https://vizyonulusalforum.com,https://www.vizyonulusalforum.com
